rmc-xeno-fruit-eat-fail-others = {CAPITALIZE(THE($xeno))}没能吃掉{THE($fruit)}。

rmc-xeno-fruit-eat-success-self = 我们吃掉了{THE($fruit)}。
rmc-xeno-fruit-eat-success-others = {CAPITALIZE(THE($xeno))}吃掉了{THE($fruit)}。

# Fruit feeding
rmc-xeno-fruit-feed-refuse = {CAPITALIZE(THE($target))}拒绝吃{THE($fruit)}。
rmc-xeno-fruit-feed-dead = {CAPITALIZE(THE($target))}已经死了，她现在已经无法从果实中获益……

