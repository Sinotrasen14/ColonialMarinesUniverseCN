rmc-xeno-fruit-pick-failed-no-longer = 我们再也无法吃掉{THE($fruit)}了。
rmc-xeno-fruit-pick-failed-not-mature = {CAPITALIZE(THE($fruit))}还没成熟。我们需要再等等。
rmc-xeno-fruit-pick-failed-health-full = 我们生命值已满！那太浪费了……
rmc-xeno-fruit-pick-failed-health-full-target = 她生命值已满！那太浪费了……

# Fruit eating
rmc-xeno-fruit-eat-start-self = 我们开始吃{THE($fruit)}。
rmc-xeno-fruit-eat-start-others = {CAPITALIZE(THE($xeno))}开始吃{THE($fruit)}。

