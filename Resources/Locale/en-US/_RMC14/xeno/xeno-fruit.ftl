rmc-xeno-fruit-feed-fail-target = {CAPITALIZE(THE($user))}没能给我们喂{THE($fruit)}。
rmc-xeno-fruit-feed-fail-others = {CAPITALIZE(THE($user))}没能给{THE($target)}喂{THE($fruit)}。

rmc-xeno-fruit-feed-success-self = 我们给{THE($target)}喂了{THE($fruit)}。
rmc-xeno-fruit-feed-success-target = {CAPITALIZE(THE($user))}给我们喂了{THE($fruit)}。
rmc-xeno-fruit-feed-success-others = {CAPITALIZE(THE($user))}给{THE($target)}喂了{THE($fruit)}。

# Fruit removed
rmc-xeno-fruit-destroyed = 我们感应到我们的一颗果实被摧毁了！
rmc-xeno-fruit-consumed = 我们的一颗树脂果实被吃掉了。
rmc-xeno-fruit-picked = 我们的一颗树脂果实被采摘了。

