# Name
loadout-name-edit-label = 设置一个自定义名称，在你扮演此角色时使用。留空则使用你的角色名。
loadout-name-edit-label-dataset = 设置一个自定义名称，在你扮演此角色时使用。留空则随机选择一个名称。
loadout-name-edit-tooltip = 最多{$max}个字符。如果未指定名称，可能会为你随机选择一个。

# Restrictions
loadout-restrictions = 限制
loadouts-min-limit = 最少数量：{$count}
loadouts-max-limit = 最多数量：{$count}
loadouts-points-limit = 点数：{$count} / {$max}

loadouts-count-items-in-group = {$item}以及另外{$count}个{$count ->
[1] item
*[other] items
}

loadouts-points-restriction = 点数不足
loadouts-selection-limit-reached = 已达到选择上限
loadouts-repeatable-name = {$name}（{$count}/{$max}）
loadouts-repeatable-name-cost = {$name}（{$count}/{$max}） — 每个{$cost}点
loadouts-skill-upgrade-name = {$name} +{$amount}
loadouts-skill-upgrade-invalid = 此技能升级配置不正确
