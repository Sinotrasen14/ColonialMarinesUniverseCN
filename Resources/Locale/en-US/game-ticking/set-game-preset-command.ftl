set-game-preset-command-description = 为接下来指定数量的回合设置游戏预设。也可以在大厅中显示另一个预设的标题和描述来迷惑玩家。
set-game-preset-command-help-text = setgamepreset <id> [number of rounds, defaulting to 1] [decoy preset]
set-game-preset-command-hint-1 = <id>
set-game-preset-command-hint-2 = [number of rounds]
set-game-preset-command-hint-3 = [decoy preset]

set-game-preset-optional-argument-not-integer = 如果提供了第2个参数，它必须是一个数字。
set-game-preset-preset-error = 找不到游戏预设“{$preset}”
set-game-preset-decoy-error = 如果提供了第3个参数，它必须是一个有效的预设。找不到游戏预设“{$preset}”

#set-game-preset-preset-set = Set game preset to "{$preset}"
set-game-preset-preset-set-finite = 已将游戏预设设为“{$preset}”，适用于接下来的{$rounds}个回合。
set-game-preset-preset-set-finite-with-decoy = 已将游戏预设设为“{$preset}”，适用于接下来的{$rounds}个回合，并在大厅中显示{$decoy}。
