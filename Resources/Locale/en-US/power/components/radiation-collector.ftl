power-radiation-collector-gas-tank-missing = 等离子罐槽位[color=darkred]为空[/color]。
power-radiation-collector-gas-tank-present = 等离子罐槽位已[color=darkgreen]装满[/color]，罐体指示器显示[color={$fullness ->
    *[0]red]empty
    [1]red]low
    [2]yellow]half-full
    [3]lime]full
}[/color]。
power-radiation-collector-enabled = 它已切换为[color={$state ->
    [true] darkgreen]on
    *[false] darkred]off
}[/color]。
