### EmitterComponent

# Shows when attempting to turn the emitter on or off without proper access
comp-emitter-access-locked = {$target}的权限被锁定了！

# Shows when turning the emitter on/off
comp-emitter-turned-on = {$target}开启了。

comp-emitter-turned-off = {$target}关闭了。

# Shows if the user attempts to activate the emitter while it's un-anchored.
comp-emitter-not-anchored = {$target}未固定在地面上！

emitter-component-current-type = 当前选择的类型是：[color=yellow]{$type}[/color]。
emitter-component-type-set = 类型已设为：{$type}

emitter-destroyed-broadcast = 位于{$location}的一台通电发射器已被摧毁。
emitter-unlocked-broadcast = 位于{$location}的一台通电发射器已解锁。
emitter-unpowered-broadcast = 位于{$location}的一台通电发射器失去了电力。
emitter-turn-off-broadcast = 位于{$location}的一台通电发射器已被关闭。
