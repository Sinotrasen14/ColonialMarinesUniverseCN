cmd-announce-desc = 使用自定义颜色和声音发送游戏内公告。
cmd-announce-help = {$command} <message> [sender] [color] [sound] - 发送公告。发送者默认为中央指挥部，颜色默认为金色，声音默认为announce.ogg。颜色应采用#RRGGBB格式。

# The default sender for the announcement
cmd-announce-sender = 中央指挥部

# Completion hints
cmd-announce-arg-message = <message>
cmd-announce-arg-sender = [sender]
cmd-announce-arg-color = [color]
cmd-announce-arg-sound = [sound]
